{
  "expo": {
    "name": "Disconnect",
    "slug": "disconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.disconnect.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Disconnect uses your location to show nearby events and beacons.",
        "NSPhotoLibraryUsageDescription": "Upload a profile photo.",
        "NSCameraUsageDescription": "Take a photo for your challenge log."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.disconnect.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Disconnect uses your location to show nearby events and beacons."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload a profile photo or challenge proof.",
          "cameraPermission": "Take a photo for your challenge log."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
