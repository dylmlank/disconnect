{
  "name": "disconnect",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "app"
  ],
  "scripts": {
    "server:dev": "npm run dev --workspace=server",
    "server:build": "npm run build --workspace=server",
    "app:start": "npm run start --workspace=app",
    "app:ios": "npm run ios --workspace=app",
    "app:android": "npm run android --workspace=app",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit --project server/tsconfig.json && tsc --noEmit --project shared/tsconfig.json"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
